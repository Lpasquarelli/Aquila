NODE_ENV=development
API_ROLE=all
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=1209600
REFRESH_SESSION_MAX_SECONDS=2592000
SESSION_NAMESPACE=v1
PASSWORD_HASH_CONCURRENCY=4
SQL_POOL_MAX=10
REDIS_MAX_INFLIGHT=10000
JWT_ISSUER=https://auth.example.com
JWT_AUDIENCE=aquila-api
JWT_ACCESS_AUDIENCES=aquila-api aquila-consumer
NATS_URL=nats://localhost:4222
REVOCATION_TIMEOUT_MS=1500
# Production: separate broker credentials and TLS for each service.
NATS_USER=aquila-auth
NATS_PASSWORD=AquilaAuth_Local_Only!42
# NATS_TLS=true
# NATS_CA_FILE=/path/to/ca.pem
JWT_SIGNING_KEY_ID=aquila-ed25519-v1
JWT_PRIVATE_KEY_PATH=keys/dev-private.pem
JWT_PUBLIC_KEY_PATH=keys/dev-public.pem
JWT_VERIFY_KEYS_JSON={"aquila-ed25519-v1":"keys/dev-public.pem"}
REDIS_URL=redis://localhost:6381
RATE_LIMIT_REDIS_URL=redis://localhost:6380
# Optional Redis Cluster startup nodes (comma-separated host:port pairs).
REDIS_CLUSTER_NODES=
RATE_LIMIT_REDIS_CLUSTER_NODES=
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1434
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=ChangeThis_Local_Only!42
SQLSERVER_DATABASE=aquila
M2M_CLIENT_ID=inventory-worker
M2M_CLIENT_PUBLIC_KEY_PATH=keys/m2m-client-public.pem
M2M_ALLOWED_SCOPES=service:ping
